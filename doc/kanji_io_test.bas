1 REM ==== KANJI I/O PORT CHARACTERISATION TEST ====
2 REM Run on a real Japanese MSX with a Kanji ROM.
3 REM Reports a compact label table instead of glyph bitmaps,
4 REM so results are typeable/photographable on ONE screen and
5 REM compare byte-exactly across machines. See openMSX issue 2138.
6 REM Ports: D8=L1 col  D9=L1 row+data  DA=L2 col  DB=L2 row+data
7 REM Tunable test chars below: pick (row,col) where L1<>L2 glyph.
10 SCREEN 0:WIDTH 40:KEY OFF:DEFINT A-Z:CLEAR 1000
20 DIM BS$(6),BN$(6)
30 PA=&HD9:QA=&HD8:PB=&HDB:QB=&HDA
40 HA=2:LA=&H3A:HB=4:LC=&H3C
50 BN$(0)="1A":BN$(1)="2A":BN$(2)="1B":BN$(3)="2B":BN$(4)="1C":BN$(5)="2C":BN$(6)="FF"
60 PRINT"building baselines..."
100 NC=32:OUT PA,HA:OUT QA,LA:PT=PA:GOSUB 1000:BS$(0)=S$
110 OUT PB,HA:OUT QB,LA:PT=PB:GOSUB 1000:BS$(1)=S$
120 OUT PA,HB:OUT QA,LA:PT=PA:GOSUB 1000:BS$(2)=S$
130 OUT PB,HB:OUT QB,LA:PT=PB:GOSUB 1000:BS$(3)=S$
140 OUT PA,HA:OUT QA,LC:PT=PA:GOSUB 1000:BS$(4)=S$
150 OUT PB,HA:OUT QB,LC:PT=PB:GOSUB 1000:BS$(5)=S$
160 K1=0:K2=0:FOR I=1 TO 32:BY=&HFF:K1=(K1+BY)AND&HFF:K2=(K2+K1)AND&HFF:NEXT:BS$(6)=RIGHT$("0"+HEX$(K2),2)+RIGHT$("0"+HEX$(K1),2)
170 FOR I=0 TO 5:FOR J=I+1 TO 6:IF BS$(I)=BS$(J) THEN PRINT"WARN dup ";BN$(I);"=";BN$(J)
175 NEXT J:NEXT I
180 NC=16:OUT PA,HA:OUT QA,LA:PT=PA:GOSUB 1000:G0$=S$:GOSUB 1000:G1$=S$
190 CLS:PRINT"KANJI IO TEST  HA=";HEX$(HA);" LA=";HEX$(LA);" HB=";HEX$(HB);" LC=";HEX$(LC):PRINT
200 NC=32:OUT PA,HA:OUT QA,LA:OUT PB,HB:OUT QB,LA:PT=PA:GOSUB 1000:GOSUB 1100:X$=L$
205 OUT PA,HA:OUT QA,LA:OUT PB,HB:OUT QB,LA:PT=PB:GOSUB 1000:GOSUB 1100:Y$=L$
210 PRINT"E1 rowcol  D9=";X$;"  DB=";Y$
220 OUT QA,LA:OUT PA,HA:OUT QB,LA:OUT PB,HB:PT=PA:GOSUB 1000:GOSUB 1100:X$=L$
225 OUT QA,LA:OUT PA,HA:OUT QB,LA:OUT PB,HB:PT=PB:GOSUB 1000:GOSUB 1100:Y$=L$
230 PRINT"E2 colrow  D9=";X$;"  DB=";Y$
240 OUT PB,HA:OUT QB,LA:OUT PA,HA:OUT QA,LA:OUT PB,HB:PT=PA:GOSUB 1000:GOSUB 1100:X$=L$
245 OUT PB,HA:OUT QB,LA:OUT PA,HA:OUT QA,LA:OUT PB,HB:PT=PB:GOSUB 1000:GOSUB 1100:Y$=L$
250 PRINT"E3a L2rowonly D9=";X$;" DB=";Y$
260 OUT PB,HA:OUT QB,LA:OUT PA,HA:OUT QA,LA:OUT QB,LC:PT=PA:GOSUB 1000:GOSUB 1100:X$=L$
265 OUT PB,HA:OUT QB,LA:OUT PA,HA:OUT QA,LA:OUT QB,LC:PT=PB:GOSUB 1000:GOSUB 1100:Y$=L$
270 PRINT"E3b L2colonly D9=";X$;" DB=";Y$
280 OUT PA,HA:OUT QA,LA:PT=PA:GOSUB 1000:GOSUB 1000:GOSUB 1100:X$=L$
285 OUT PB,HA:OUT QB,LA:PT=PB:GOSUB 1000:GOSUB 1000:GOSUB 1100:Y$=L$
290 PRINT"E4 read33-64 L1=";X$;" L2=";Y$
300 NC=16:OUT PA,HA:OUT QA,LA:PT=PA:GOSUB 1000:OUT QA,LA:GOSUB 1000:GOSUB 320:X$=R$
305 OUT PA,HA:OUT QA,LA:PT=PA:GOSUB 1000:OUT PA,HA:GOSUB 1000:GOSUB 320:Y$=R$
310 PRINT"E5 recnt  colW=";X$;"  rowW=";Y$:GOTO 400
320 R$="?"+S$:IF S$=G0$ THEN R$="RST"
322 IF S$=G1$ THEN R$="CONT"
324 RETURN
400 PRINT:PRINT"Report every label + machine name.":PRINT"? = unknown glyph (raw sig shown)."
410 END
1000 K1=0:K2=0:FOR I=1 TO NC:BY=INP(PT):K1=(K1+BY)AND&HFF:K2=(K2+K1)AND&HFF:NEXT
1010 S$=RIGHT$("0"+HEX$(K2),2)+RIGHT$("0"+HEX$(K1),2):RETURN
1100 L$="?"+S$:FOR I=0 TO 6:IF S$=BS$(I) THEN L$=BN$(I):I=6
1110 NEXT:RETURN
